rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // R1586 HOLD: a familyId claim is NOT a media/story grant.
    // Real private photos/audio remain server/broker-only until scoped consent,
    // IAM and generation fencing are independently certified.
    match /families/{familyId}/stories/{storyId}/{fileName} {
      allow read, write: if false;
    }

    match /families/{familyId}/exports/{fileName} {
      allow read, write: if false;
    }

    match /moderation/{fileName} {
      allow read, write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
