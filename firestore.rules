rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isOwner(userId) {
      return isSelf(userId);
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.keys().hasAny(['admin'])
        && request.auth.token.admin == true;
    }

    function familyRef(familyId) {
      return /databases/$(database)/documents/families/$(familyId);
    }

    function familyRole(familyId) {
      return get(familyRef(familyId)).data.members[request.auth.uid].role;
    }
    function isFamilyMember(familyId) {
      return signedIn() && exists(familyRef(familyId)) && familyRole(familyId) in ['owner', 'guardian', 'viewer'];
    }
    function canManageFamily(familyId) {
      return signedIn() && exists(familyRef(familyId)) && familyRole(familyId) in ['owner', 'guardian'];
    }
    function ownerOnlyCreate() { return signedIn() && request.resource.data.userId == request.auth.uid; }
    function ownerOnlyReadWrite(userId) { return isOwner(userId) || isAdmin(); }
    // Generated story and consent authority is written by verified server callables,
    // never by a client using an owner claim. Admin SDK bypasses these rules.
    function privateFiniteTimeCreate() {
      return signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.privacyClass == 'owner-only'
        && request.resource.data.finalRenderingAuthorized == false
        && request.resource.data.providerSpendAuthorized == false;
    }
    function privateFiniteTimeExisting() {
      return signedIn()
        && resource.data.ownerId == request.auth.uid
        && resource.data.privacyClass == 'owner-only';
    }
    function privateFiniteTimeUpdate() {
      return privateFiniteTimeExisting()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.privacyClass == 'owner-only'
        && request.resource.data.finalRenderingAuthorized == false
        && request.resource.data.providerSpendAuthorized == false;
    }

    function activePublicShare() {
      return resource.data.keys().hasAll([
          'schemaVersion',
          'slug',
          'title',
          'safeSummary',
          'safeBody',
          'revoked',
          'expiresAt'
        ])
        && !resource.data.keys().hasAny(['userId', 'sessionId'])
        && resource.data.schemaVersion == 'public-story-share-v2'
        && resource.data.slug is string
        && resource.data.title is string
        && resource.data.safeSummary is string
        && resource.data.safeBody is string
        && resource.data.revoked == false
        && resource.data.expiresAt is timestamp
        && request.time < resource.data.expiresAt;
    }

    match /users/{userId} {
      allow read, create, update: if isSelf(userId);
      allow delete: if false;
    }
    match /families/{familyId} {
      allow read: if isFamilyMember(familyId) || isAdmin();
      allow create: if signedIn() && request.resource.data.members[request.auth.uid].role == 'owner';
      allow update: if canManageFamily(familyId) || isAdmin();
      allow delete: if false;
    }
    match /childProfiles/{profileId} {
      allow read: if isFamilyMember(resource.data.familyId) || isAdmin();
      allow create: if canManageFamily(request.resource.data.familyId);
      allow update: if canManageFamily(resource.data.familyId) || isAdmin();
      allow delete: if false;
    }
    match /stories/{storyId} {
      allow read: if isFamilyMember(resource.data.familyId) || isAdmin();
      allow create: if canManageFamily(request.resource.data.familyId);
      allow update: if canManageFamily(resource.data.familyId) || isAdmin();
      allow delete: if false;
    }
    match /storyRuns/{runId} {
      allow read: if isFamilyMember(resource.data.familyId) || isAdmin();
      allow create: if canManageFamily(request.resource.data.familyId);
      allow update, delete: if false;
    }
    match /storySafetyReports/{reportId} {
      allow read: if isSelf(resource.data.userId) || isAdmin();
      allow create, update, delete: if false;
    }
    match /storytimeSafetyReportCounters/{id} { allow read, write: if false; }
    match /moderation/{moderationId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /moderationAuditLogs/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    match /auditLogs/{auditLogId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    match /privacyRequests/{requestId} {
      allow read: if isSelf(resource.data.userId) || isAdmin();
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if false;
    }
    match /storySessions/{id} {
      allow read: if ownerOnlyReadWrite(resource.data.userId);
      allow create, update, delete: if false;
    }
    match /storyChapters/{id} {
      allow read: if ownerOnlyReadWrite(resource.data.userId);
      allow create, update, delete: if false;
    }
    match /storyMoments/{id} {
      allow read: if ownerOnlyReadWrite(resource.data.userId);
      allow create, update, delete: if false;
    }
    match /memoryScenes/{id} {
      allow read: if ownerOnlyReadWrite(resource.data.userId);
      allow create, update, delete: if false;
    }
    match /narratorScripts/{id} {
      allow read: if ownerOnlyReadWrite(resource.data.userId);
      allow create, update, delete: if false;
    }
    match /ritualStorycards/{id} {
      allow read: if ownerOnlyReadWrite(resource.data.userId);
      allow create, update, delete: if false;
    }
    match /userStoryPreferences/{id} {
      allow create: if ownerOnlyCreate();
      allow read, update, delete: if ownerOnlyReadWrite(resource.data.userId);
    }
    match /storyExports/{id} {
      allow read: if ownerOnlyReadWrite(resource.data.userId);
      allow create, update, delete: if false;
    }
    match /voiceoverJobs/{id} {
      allow read: if ownerOnlyReadWrite(resource.data.userId);
      allow create, update, delete: if false;
    }
    match /timelineReplayEvents/{id} {
      allow read: if ownerOnlyReadWrite(resource.data.userId);
      allow create, update, delete: if false;
    }
    match /emotionalArcSummaries/{id} {
      allow read: if ownerOnlyReadWrite(resource.data.userId);
      allow create, update, delete: if false;
    }
    match /relationshipStoryThreads/{id} {
      allow read: if ownerOnlyReadWrite(resource.data.userId);
      allow create, update, delete: if false;
    }
    match /weeklyStoryScrolls/{id} {
      allow read: if ownerOnlyReadWrite(resource.data.userId);
      allow create, update, delete: if false;
    }
    match /monthlyStoryScrolls/{id} {
      allow read: if ownerOnlyReadWrite(resource.data.userId);
      allow create, update, delete: if false;
    }
    match /storyAnalyticsEvents/{id} {
      allow create: if ownerOnlyCreate();
      allow read: if ownerOnlyReadWrite(resource.data.userId);
      allow update, delete: if false;
    }
    match /storytimeUsageCounters/{id} { allow read, write: if false; }
    match /storytimeProviderBudgetCounters/{id} { allow read, write: if false; }
    match /storytimeProviderBudgetReservations/{id} { allow read, write: if false; }
    match /storytimeProviderDeadLetters/{id} { allow read, write: if false; }
    match /storyGenerationRequests/{id} { allow read, write: if false; }
    match /storytimeGenerationAdmissionGuards/{id} { allow read, write: if false; }
    match /storyArchiveSnapshots/{id} { allow read, write: if false; }
    match /storyDrafts/{id} {
      allow read: if ownerOnlyReadWrite(resource.data.userId);
      allow create, update, delete: if false;
    }
    match /storyVersions/{id} {
      allow read: if ownerOnlyReadWrite(resource.data.userId);
      allow create, update, delete: if false;
    }
    match /privacyDeletionPlans/{planId} { allow read, write: if false; }
    match /privacyOperationReceipts/{receiptId} { allow read, write: if false; }
    match /publicStoryShares/{id} {
      allow read: if activePublicShare();
      allow create, update, delete: if false;
    }

    match /publicStoryShareControls/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /finiteTimeCanonRegistries/{id} {
      allow read: if privateFiniteTimeExisting();
      allow create, update, delete: if false;
    }
    match /finiteTimeCanonRegistryRevisions/{id} {
      allow read, write: if false;
    }
    match /finiteTimeShotGraphs/{id} {
      allow read, delete: if privateFiniteTimeExisting();
      allow create, update: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
